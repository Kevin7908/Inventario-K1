# Credenciales de la instalación de InventarioK1.
#
# Copiar este archivo como `.env` en la raíz del proyecto —o junto al
# ejecutable, en una instalación real— y rellenarlo. `.env` está en
# `.gitignore`: nunca sube al repositorio.
#
# Si el archivo no existe o le falta alguna clave, la app arranca igual y el
# envío de correos queda desactivado: recuperar la contraseña avisa de que el
# correo no está configurado en vez de fallar en silencio.

# Cuenta desde la que salen los correos.
# Con Gmail no va la contraseña de la cuenta sino una **contraseña de
# aplicación** de 16 caracteres (Cuenta de Google → Seguridad → Verificación
# en dos pasos → Contraseñas de aplicaciones).
CORREO_USUARIO=
CORREO_PASSWORD=

# Servidor SMTP. Los valores de abajo son los de Gmail.
CORREO_HOST=smtp.gmail.com
CORREO_PUERTO=587
CORREO_SSL=false

# Opcionales. `CORREO_REMITENTE` solo si el "de" debe verse distinto de
# `CORREO_USUARIO`; `CORREO_NOMBRE` es el nombre que ve quien recibe.
CORREO_REMITENTE=
CORREO_NOMBRE=InventarioK1
